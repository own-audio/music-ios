    "Add Server" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidat server"
          }
        }
      }
    },
    "Add the server's address on your home network, a VPN such as Tailscale, or a second public name. On each network the app uses the fastest one that answers as this server." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte adresu serveru v domácí síti, ve VPN (třeba Tailscale) nebo druhé veřejné jméno. V každé síti aplikace použije nejrychlejší adresu, která odpoví jako tento server."
          }
        }
      }
    },
    "Add to Playlist" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidat do playlistu"
          }
        }
