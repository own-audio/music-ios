            "value" : "Odmítnout"
          }
        }
      }
    },
    "No one release fits all these songs, so each was matched on its own. Pick a release to match the whole album to it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádné jedno vydání nesedí na všechny tyto skladby, proto se každá párovala zvlášť. Vyberte vydání, ke kterému se má spárovat celé album."
          }
        }
      }
    },
    "No other editions were found." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiné edice se nenašly."
