    "Synced" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časovaný"
          }
        }
      }
    },
    "Tap the star on an album." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na hvězdičku u alba."
          }
