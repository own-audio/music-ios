    "Nothing Fits Right Now" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teď nic neodpovídá"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade passt nichts"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no encaja nada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne correspond pour l’instant"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most semmi sem felel meg"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non corrisponde nulla"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz nič nevyhovuje"
          }
        }
      }
    },
    "Nothing in the library fits this rule at the moment. A wider rule gives more to choose from." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomuto pravidlu teď v knihovně nic neodpovídá. Širší pravidlo dá víc na výběr."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade passt nichts in der Mediathek zu dieser Regel. Eine weiter gefasste Regel bietet mehr Auswahl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no hay nada en la biblioteca que encaje con esta regla. Una regla más amplia da más donde elegir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien dans la bibliothèque ne correspond à cette règle pour l’instant. Une règle plus large offre plus de choix."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A könyvtárban most semmi sem felel meg ennek a szabálynak. Egy tágabb szabály több választást ad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento niente nella libreria corrisponde a questa regola. Una regola più ampia offre più scelta."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomuto pravidlu teraz v knižnici nič nevyhovuje. Širšie pravidlo dá viac na výber."
          }
        }
      }
    },
    "Nothing Logged Yet" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím nic nezaznamenáno"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts protokolliert"
