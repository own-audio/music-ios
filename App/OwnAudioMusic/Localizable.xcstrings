    "Your sign-in stays in this device's Keychain. Subsonic servers get a one-time token made from the password; Jellyfin gives a token and the password isn't kept." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlášení zůstává v klíčence tohoto zařízení. Servery Subsonic dostávají jednorázový token vytvořený z hesla; Jellyfin vydá token a heslo se neukládá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Anmeldung bleibt im Schlüsselbund dieses Geräts. Subsonic-Server bekommen ein Einmal-Token aus dem Passwort; Jellyfin gibt ein Token aus, und das Passwort wird nicht gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu inicio de sesión se queda en el llavero de este dispositivo. Los servidores Subsonic reciben un token de un solo uso creado a partir de la contraseña; Jellyfin da un token y la contraseña no se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos identifiants restent dans le trousseau de cet appareil. Les serveurs Subsonic reçoivent un jeton à usage unique dérivé du mot de passe ; Jellyfin fournit un jeton et le mot de passe n’est pas conservé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bejelentkezése ennek az eszköznek a kulcskarikájában marad. A Subsonic-szerverek a jelszóból készült egyszeri tokent kapnak; a Jellyfin tokent ad, a jelszót pedig nem tárolja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue credenziali restano nel portachiavi di questo dispositivo. I server Subsonic ricevono un token monouso ricavato dalla password; Jellyfin fornisce un token e la password non viene conservata."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prihlásenie zostáva v kľúčenke tohto zariadenia. Servery Subsonic dostávajú jednorazový token vytvorený z hesla; Jellyfin vydá token a heslo sa neukladá."
          }
        }
      }
    },
    "“%@” is not a time. Write it as 9:26 or 1:02:03." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ není čas. Zapište ho jako 9:26 nebo 1:02:03."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist keine Zeitangabe. Gib sie als 9:26 oder 1:02:03 ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no es un tiempo válido. Escríbelo como 9:26 o 1:02:03."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas une durée valide. Écrivez-la sous la forme 9:26 ou 1:02:03."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” nem érvényes időérték. Így írja: 9:26 vagy 1:02:03."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non è un tempo valido. Scrivilo come 9:26 o 1:02:03."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ nie je čas. Zapíšte ho ako 9:26 alebo 1:02:03."
          }
        }
      }
    },
    "Every song needs a name." : {
      "localizations" : {
        "cs" : {
