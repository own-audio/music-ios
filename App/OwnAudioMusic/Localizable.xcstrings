    },
    "That is on another server. Switch to it in Settings first." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je na jiném serveru. Nejdřív se na něj přepněte v Nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist auf einem anderen Server. Wechsle zuerst in den Einstellungen zu ihm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso está en otro servidor. Cambia a él primero en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est sur un autre serveur. Basculez d’abord vers ce serveur dans Réglages."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez egy másik szerveren van. Előbb váltson rá a Beállításokban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
