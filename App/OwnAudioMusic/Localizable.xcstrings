    "This account asks for a second step. Enter the code your authenticator app shows for it, or one of your recovery codes." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento účet vyžaduje druhý krok. Zadejte kód, který pro něj ukazuje vaše ověřovací aplikace, nebo jeden ze záchranných kódů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto verlangt einen zweiten Schritt. Gib den Code ein, den deine Authentifizierungs-App dafür anzeigt, oder einen deiner Wiederherstellungscodes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta pide un segundo paso. Introduce el código que muestra tu app de autenticación para ella, o uno de tus códigos de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte demande une seconde étape. Saisissez le code que votre app d’authentification affiche pour lui, ou l’un de vos codes de récupération."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a fiók második lépést kér. Adja meg a hitelesítő alkalmazásban ehhez a fiókhoz megjelenő kódot, vagy az egyik helyreállítási kódját."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo account richiede un secondo passaggio. Inserisci il codice mostrato dalla tua app di autenticazione o uno dei tuoi codici di recupero."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento účet vyžaduje druhý krok. Zadajte kód, ktorý preň ukazuje vaša overovacia aplikácia, alebo jeden z kódov na obnovenie."
          }
        }
      }
