          }
        }
      }
    },
    "There is nothing to continue; play something in own.music first." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Není v čem pokračovat; nejdřív něco pusťte v own.music."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt nichts zum Weiterhören; spiel zuerst etwas in own.music ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada que continuar; reproduce algo primero en own.music."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à reprendre ; lancez d’abord quelque chose dans own.music."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
