          }
        }
      }
    },
    "The library shows the selected server." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knihovna ukazuje vybraný server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mediathek zeigt den Inhalt des ausgewählten Servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La biblioteca muestra el servidor seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bibliothèque affiche le contenu du serveur sélectionné."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A könyvtár a kiválasztott szervert mutatja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La libreria mostra il server selezionato."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knižnica ukazuje vybraný server."
          }
        }
      }
    },
    "The password needs at least 12 characters. A few words are fine." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heslo musí mít alespoň 12 znaků. Klidně několik slov."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort braucht mindestens 12 Zeichen. Ein paar Wörter sind in Ordnung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña necesita al menos 12 caracteres. Unas cuantas palabras valen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe doit comporter au moins 12 caractères. Quelques mots suffisent."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelszónak legalább 12 karakterből kell állnia. Néhány szó is megfelel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password deve avere almeno 12 caratteri. Vanno bene anche alcune parole."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heslo musí mať aspoň 12 znakov. Pokojne niekoľko slov."
          }
        }
      }
    },
    "The server doesn't have that any more." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server už to nemá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat das nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ya no lo tiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur ne l’a plus."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez már nincs meg a szerveren."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non lo ha più."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server to už nemá."
          }
        }
      }
    },
    "The server has no lyrics for this song. Servers read them from the file's tags or an .lrc file next to it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server k této skladbě nemá text. Servery ho čtou z tagů souboru nebo ze souboru .lrc vedle něj."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat keinen Songtext für diesen Titel. Server lesen ihn aus den Tags der Datei oder aus einer .lrc-Datei daneben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no tiene la letra de esta canción. Los servidores la leen de las etiquetas del archivo o de un archivo .lrc junto a él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n’a pas les paroles de ce morceau. Les serveurs les lisent dans les balises du fichier ou dans un fichier .lrc placé à côté."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szervernek nincs dalszövege ehhez a számhoz. A szerverek a fájl címkéiből vagy a mellette lévő .lrc fájlból olvassák."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non ha il testo di questo brano. I server lo leggono dai tag del file o da un file .lrc accanto."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server k tejto skladbe nemá text. Servery ho čítajú zo značiek súboru alebo zo súboru .lrc vedľa neho."
          }
        }
      }
    },
    "The server no longer accepts this sign-in." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server už toto přihlášení nepřijímá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server akzeptiert diese Anmeldung nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor ya no acepta este inicio de sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n’accepte plus cette connexion."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver már nem fogadja el ezt a bejelentkezést."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non accetta più questo accesso."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server už toto prihlásenie neprijíma."
          }
        }
      }
    },
    "The server tells the app its addresses and an identity, so an address that answers as a different server is never used." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server aplikaci sdělí své adresy a identitu, takže adresa, která odpoví jako jiný server, se nikdy nepoužije."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server nennt der App seine Adressen und eine Identität, sodass eine Adresse, die als anderer Server antwortet, nie verwendet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor le dice a la app sus direcciones y una identidad, así que nunca se usa una dirección que responda como otro servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur indique à l’app ses adresses et son identité, ainsi une adresse qui répond comme un autre serveur n’est jamais utilisée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver közli az alkalmazással a címeit és az azonosságát, így olyan cím, amely másik szerverként válaszol, soha nem kerül használatba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server comunica all’app i suoi indirizzi e un’identità, quindi un indirizzo che risponde come un altro server non viene mai usato."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server aplikácii oznámi svoje adresy a identitu, takže adresa, ktorá odpovie ako iný server, sa nikdy nepoužije."
          }
        }
      }
    },
    "The server's answer couldn't be read." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpověď serveru se nepodařilo přečíst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Antwort des Servers konnte nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
