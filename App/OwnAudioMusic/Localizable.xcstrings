          "stringUnit" : {
            "state" : "translated",
            "value" : "To je na inom serveri. Najprv sa naň prepnite v Nastaveniach."
          }
        }
      }
    },
    "The app writes here when something goes wrong." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
