    "Tracks fade into each other near the end." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skladby se ke konci prolnou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titel gehen gegen Ende ineinander über."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las canciones se funden entre sí cerca del final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les morceaux se fondent l’un dans l’autre vers la fin."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A számok a végük felé egymásba úsznak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I brani sfumano l’uno nell’altro verso la fine."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skladby sa ku koncu prelínajú."
          }
        }
      }
    },
    "Tracks play back to back with no gap, so live and classical albums flow as recorded." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skladby hrají za sebou bez mezery, takže živá a klasická alba plynou tak, jak byla nahrána."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titel laufen ohne Pause nacheinander, damit Live- und Klassikalben so fließen, wie sie aufgenommen wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las canciones suenan seguidas sin pausa, para que los álbumes en directo y de clásica fluyan tal como se grabaron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
