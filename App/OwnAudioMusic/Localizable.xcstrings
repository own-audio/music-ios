          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur cet appareil"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen az eszközön"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questo dispositivo"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tomto zariadení"
          }
        }
      }
    },
    "Only songs the server has analysed have a tempo and an energy; with these set, the others are left out." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo a energii mají jen skladby, které server analyzoval; když je nastavíte, ostatní se vynechají."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Titel, die der Server analysiert hat, haben Tempo und Energie; sind diese gesetzt, fallen die anderen weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo las canciones que el servidor ha analizado tienen tempo y energía; si los defines, las demás se quedan fuera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les morceaux analysés par le serveur ont un tempo et une énergie ; si vous les définissez, les autres sont exclus."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempója és energiája csak a szerver által elemzett számoknak van; ha ezeket beállítja, a többi kimarad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo i brani analizzati dal server hanno tempo ed energia; se li imposti, gli altri restano esclusi."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo a energiu majú len skladby, ktoré server analyzoval; keď ich nastavíte, ostatné sa vynechajú."
          }
        }
      }
    },
    "Or connect your own server" : {
