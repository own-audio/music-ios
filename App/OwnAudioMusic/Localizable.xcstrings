    "An invitation is a code for one person. They sign in to this server and enter it, or open its link." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozvánka je kód pro jednoho člověka. Přihlásí se k tomuto serveru a zadá ho, nebo otevře její odkaz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Einladung ist ein Code für eine Person. Die Person meldet sich bei diesem Server an und gibt den Code ein oder öffnet den Link."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una invitación es un código para una persona. Esa persona inicia sesión en este servidor y lo introduce, o abre su enlace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une invitation est un code pour une seule personne. Elle se connecte à ce serveur et le saisit, ou ouvre son lien."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A meghívó egy kód egyetlen személy számára. Ő bejelentkezik erre a szerverre, és megadja a kódot, vagy megnyitja a meghívó hivatkozását."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un invito è un codice per una persona. Accede a questo server e lo inserisce, oppure ne apre il link."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozvánka je kód pre jedného človeka. Prihlási sa k tomuto serveru a zadá ho, alebo otvorí jej odkaz."
          }
        }
      }
    },
