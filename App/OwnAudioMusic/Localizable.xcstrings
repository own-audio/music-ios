    "Download albums and playlists to listen without a network." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stáhněte si alba a playlisty a poslouchejte je i bez sítě."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Alben und Playlists herunter, um sie ohne Netz zu hören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga álbumes y playlists para escucharlos sin red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez des albums et des playlists pour les écouter sans réseau."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töltsön le albumokat és listákat, hogy hálózat nélkül is hallgathassa őket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica album e playlist per ascoltarli senza rete."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiahnite si albumy a playlisty a počúvajte ich aj bez siete."
          }
        }
      }
    },
    "Download an album or a playlist with the arrow on its page, or a song from its menu. It then plays without a network." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album nebo playlist stáhnete šipkou na jeho stránce, skladbu z její nabídky. Pak hraje i bez sítě."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade ein Album oder eine Playlist mit dem Pfeil auf der jeweiligen Seite herunter, einen Titel über sein Menü. Danach läuft er auch ohne Netz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga un álbum o una playlist con la flecha de su página, o una canción desde su menú. Así se reproduce sin red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez un album ou une playlist avec la flèche sur sa page, ou un morceau depuis son menu. Vous pourrez alors l’écouter sans réseau."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albumot vagy listát az oldalán lévő nyíllal tölthet le, egy számot a menüjéből. Ezután hálózat nélkül is szól."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica un album o una playlist con la freccia nella sua pagina, o un brano dal suo menu. Poi si riproduce anche senza rete."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album alebo playlist stiahnete šípkou na jeho stránke, skladbu z jej ponuky. Potom hrá aj bez siete."
          }
        }
      }
    },
