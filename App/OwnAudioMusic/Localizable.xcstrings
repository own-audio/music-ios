    "Delete Account" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazat účet"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto löschen"
          }
        },
        "es" : {
          "stringUnit" : {
