    "For buttons, links and what's playing. The icon and the widgets keep the app's color." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro tlačítka, odkazy a to, co hraje. Ikona a widgety si ponechají barvu aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Tasten, Links und das, was gerade läuft. Das Symbol und die Widgets behalten die Farbe der App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para botones, enlaces y lo que está sonando. El icono y los widgets mantienen el color de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les boutons, les liens et ce qui est en cours de lecture. L’icône et les widgets gardent la couleur de l’app."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gombokhoz, hivatkozásokhoz és ahhoz, ami szól. Az ikon és a widgetek megtartják az alkalmazás színét."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per pulsanti, link e ciò che è in riproduzione. L’icona e i widget mantengono il colore dell’app."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre tlačidlá, odkazy a to, čo hrá. Ikona a widgety si ponechajú farbu aplikácie."
          }
        }
      }
    },
    "Delete Account…" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
