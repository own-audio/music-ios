    "Delete Your Account?" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazat váš účet?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto löschen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar tu cuenta?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer votre compte ?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törli a fiókját?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminare il tuo account?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmazať váš účet?"
          }
        }
      }
    },
    "Your account on %@ is deleted for good, with everything you added to it: music, audiobooks, podcasts, playlists and your listening history. What others in your family added stays with them." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš účet na %@ bude nevratně smazán se vším, co jste do něj přidali: hudbou, audioknihami, podcasty, playlisty i historií poslechu. Co přidali ostatní z rodiny, jim zůstane."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto auf %@ wird endgültig gelöscht, mit allem, was du hinzugefügt hast: Musik, Hörbücher, Podcasts, Playlists und dein Hörverlauf. Was andere in deiner Familie hinzugefügt haben, bleibt bei ihnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta en %@ se eliminará para siempre, con todo lo que añadiste: música, audiolibros, podcasts, playlists y tu historial de escucha. Lo que añadieron otros miembros de tu familia se queda con ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte sur %@ sera supprimé définitivement, avec tout ce que vous y avez ajouté : musique, livres audio, podcasts, playlists et votre historique d’écoute. Ce que les autres membres de votre famille ont ajouté leur reste."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiókja végleg törlődik erről a szerverről (%@), mindennel együtt, amit hozzáadott: zenével, hangoskönyvekkel, podcastokkal, listákkal és a hallgatási előzményeivel. Amit a család többi tagja adott hozzá, az náluk marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account su %@ viene eliminato per sempre, con tutto ciò che vi hai aggiunto: musica, audiolibri, podcast, playlist e cronologia d’ascolto. Ciò che hanno aggiunto gli altri della famiglia resta a loro."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš účet na %@ bude natrvalo zmazaný so všetkým, čo ste doň pridali: hudbou, audioknihami, podcastmi, playlistami aj históriou počúvania. Čo pridali ostatní z rodiny, im zostane."
          }
        }
      }
    },
    "This is the server's only admin account. Make someone else an admin on the server first, or delete the account there." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto je jediný účet správce serveru. Nejdřív na serveru udělejte správcem někoho jiného, nebo účet smažte tam."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist das einzige Administratorkonto des Servers. Mach zuerst jemand anderen auf dem Server zum Administrator oder lösche das Konto dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es la única cuenta de administrador del servidor. Primero haz administrador a otra persona en el servidor, o elimina la cuenta allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est le seul compte administrateur du serveur. Nommez d’abord quelqu’un d’autre administrateur sur le serveur, ou supprimez le compte là-bas."
          }
        },
        "hu" : {
