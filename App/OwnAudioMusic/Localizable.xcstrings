    "Quick Connect" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect"
          }
        }
      }
    },
    "Quick Connect Didn't Work" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect se nepovedl"
          }
        }
      }
    },
    "Quick Connect is a Jellyfin feature, and there is no Jellyfin server at that address." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect je funkce Jellyfinu a na této adrese žádný server Jellyfin není."
          }
        }
      }
    },
    "Quick Connect is turned off on this server. An administrator can turn it on in the dashboard, or sign in with your password." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect je na tomto serveru vypnutý. Správce ho může zapnout v ovládacím panelu, nebo se přihlaste heslem."
          }
        }
      }
    },
    "Quick Connect signs in to Jellyfin with a code you approve in a Jellyfin app where you're already signed in; no password typed here." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect přihlásí k Jellyfinu pomocí kódu, který schválíte v aplikaci Jellyfin, kde už jste přihlášeni; heslo se tu nezadává."
          }
        }
      }
    },
    "Sign In" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlásit se"
          }
        }
      }
    },
    "Sign In Again" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlásit se znovu"
          }
        }
      }
    },
    "Sign In with Quick Connect (Jellyfin)" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlásit přes Quick Connect (Jellyfin)"
          }
        }
      }
    },
    "Signed in as %@. Downloads and the library on this iPhone stay as they are." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlášeno jako %@. Stažené skladby a knihovna v tomto iPhonu zůstanou, jak jsou."
          }
        }
      }
    },
    "Streaming" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamování"
          }
        }
      }
    },
    "Subsonic API" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subsonic API"
          }
        }
      }
    },
    "Subsonic servers don't say which addresses they have, so add them here; the app checks each one with your sign-in." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servery Subsonic neříkají, jaké mají adresy, proto je přidejte sem; aplikace každou ověří vaším přihlášením."
          }
        }
      }
    },
    "Talks Through" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojení přes"
          }
        }
      }
    },
    "Tells the server what's playing and counts plays: on Subsonic servers once you've heard half a song or four minutes, on Jellyfin by its own rules. Plays made offline are sent later. The server can pass them on to Last.fm or ListenBrainz." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Říká serveru, co hraje, a počítá přehrání: u serverů Subsonic po poslechu poloviny skladby nebo čtyř minut, u Jellyfinu podle jeho pravidel. Přehrání bez sítě se odešlou později. Server je může předávat na Last.fm nebo ListenBrainz."
          }
        }
      }
    },
    "That address now answers as a different server. Add it as a new server instead." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na této adrese teď odpovídá jiný server. Přidejte ho jako nový server."
          }
        }
      }
    },
    "That code isn't right, or it has expired. Try the current one." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kód není správný, nebo už vypršel. Zadejte aktuální."
          }
        }
      }
    },
    "The server doesn't have that any more." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server už to nemá."
          }
        }
      }
    },
    "The server has no lyrics for this song. Servers read them from the file's tags or an .lrc file next to it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server k této skladbě nemá text. Servery ho čtou z tagů souboru nebo ze souboru .lrc vedle něj."
          }
        }
      }
    },
    "The server no longer accepts this sign-in." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server už toto přihlášení nepřijímá."
          }
        }
      }
    },
    "The server tells the app its addresses and an identity, so an address that answers as a different server is never used." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server aplikaci sdělí své adresy a identitu, takže adresa, která odpoví jako jiný server, se nikdy nepoužije."
          }
        }
      }
    },
    "The server's answer couldn't be read." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpověď serveru se nepodařilo přečíst."
          }
        }
      }
    },
    "This account asks for a second step. Enter the code your authenticator app shows for it, or one of your recovery codes." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento účet vyžaduje druhý krok. Zadejte kód, který pro něj ukazuje vaše ověřovací aplikace, nebo jeden ze záchranných kódů."
          }
        }
      }
    },
    "This account isn't allowed to do that." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento účet to nemá povolené."
          }
        }
      }
    },
    "This server doesn't support that." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server to nepodporuje."
          }
        }
      }
