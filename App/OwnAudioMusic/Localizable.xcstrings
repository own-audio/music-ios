            "value" : "Semaine"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hét"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settimana"
          }
        },
        "sk" : {
