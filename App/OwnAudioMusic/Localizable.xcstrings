    "The library shows the selected server. Music from any server can stay in the queue." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knihovna ukazuje vybraný server. Hudba z kteréhokoli serveru může zůstat ve frontě."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mediathek zeigt den Inhalt des ausgewählten Servers. Musik von jedem Server kann in der Warteschlange bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La biblioteca muestra el servidor seleccionado. La música de cualquier servidor puede quedarse en la cola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bibliothèque affiche le contenu du serveur sélectionné. La musique de n’importe quel serveur peut rester dans la file d’attente."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A könyvtár a kiválasztott szervert mutatja. Bármelyik szerver zenéje a lejátszási sorban maradhat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La libreria mostra il server selezionato. La musica di qualsiasi server può restare in coda."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knižnica ukazuje vybraný server. Hudba z ktoréhokoľvek servera môže zostať v poradí."
          }
        }
      }
    },
    "The server didn't accept that username and password." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server toto uživatelské jméno a heslo nepřijal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat diesen Benutzernamen und dieses Passwort nicht akzeptiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no ha aceptado ese nombre de usuario y contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n’a pas accepté ce nom d’utilisateur et ce mot de passe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerver nem fogadta el ezt a felhasználónevet és jelszót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non ha accettato questo nome utente e questa password."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server toto používateľské meno a heslo neprijal."
          }
        }
      }
    },
    "The server has no lyrics for this song. Navidrome reads them from the file's tags or an .lrc file next to it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server pro tuto skladbu nemá text. Navidrome ho čte ze značek souboru nebo ze souboru .lrc vedle něj."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat keinen Songtext für diesen Titel. Navidrome liest ihn aus den Tags der Datei oder aus einer .lrc-Datei daneben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no tiene la letra de esta canción. Navidrome la lee de las etiquetas del archivo o de un archivo .lrc junto a él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n’a pas les paroles de ce morceau. Navidrome les lit dans les balises du fichier ou dans un fichier .lrc placé à côté."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szervernek nincs dalszövege ehhez a számhoz. A Navidrome a fájl címkéiből vagy a mellette lévő .lrc fájlból olvassa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non ha il testo di questo brano. Navidrome lo legge dai tag del file o da un file .lrc accanto."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server k tejto skladbe nemá text. Navidrome ho číta zo značiek súboru alebo zo súboru .lrc vedľa neho."
          }
        }
      }
    },
    "The server no longer accepts this sign-in. Check it in Settings." : {
