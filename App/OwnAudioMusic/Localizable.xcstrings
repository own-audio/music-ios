    "A list of everything on the server, without the music itself, so albums open and the library can be browsed offline. Updated in the background, on Wi-Fi." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seznam všeho na serveru, bez samotné hudby, aby se alba otevřela a knihovnu šlo procházet i offline. Aktualizuje se na pozadí, na Wi-Fi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Liste von allem auf dem Server, ohne die Musik selbst, damit sich Alben öffnen und die Mediathek offline durchsuchen lässt. Wird im Hintergrund über WLAN aktualisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una lista de todo lo que hay en el servidor, sin la música en sí, para que los álbumes se abran y la biblioteca se pueda explorar sin conexión. Se actualiza en segundo plano, con Wi-Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une liste de tout ce qui est sur le serveur, sans la musique elle-même, pour que les albums s’ouvrent et que la bibliothèque se parcoure hors ligne. Mise à jour en arrière-plan, en Wi-Fi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista mindenről, ami a szerveren van, maga a zene nélkül, hogy az albumok megnyíljanak, és a könyvtár offline is böngészhető legyen. Wi-Fi-n, a háttérben frissül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un elenco di tutto ciò che è sul server, senza la musica, così gli album si aprono e la libreria si può sfogliare offline. Si aggiorna in background, con il Wi-Fi."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoznam všetkého na serveri, bez samotnej hudby, aby sa albumy otvorili a knižnicu bolo možné prechádzať aj offline. Aktualizuje sa na pozadí, cez Wi-Fi."
          }
        }
      }
    },
