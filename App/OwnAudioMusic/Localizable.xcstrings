    "This isn't an own.audio server. Sign in with Apple or Google works only there; use the server's username and password." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tohle není server own.audio. Přihlášení přes Apple nebo Google funguje jen tam; použijte uživatelské jméno a heslo serveru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist kein own.audio-Server. Die Anmeldung mit Apple oder Google funktioniert nur dort; verwende den Benutzernamen und das Passwort des Servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no es un servidor de own.audio. Iniciar sesión con Apple o Google solo funciona allí; usa el nombre de usuario y la contraseña del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n’est pas un serveur own.audio. La connexion avec Apple ou Google ne fonctionne qu’avec ces serveurs ; utilisez le nom d’utilisateur et le mot de passe du serveur."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez nem own.audio-szerver. Az Apple- vagy Google-bejelentkezés csak ott működik; használja a szerver felhasználónevét és jelszavát."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo non è un server own.audio. L’accesso con Apple o Google funziona solo lì; usa il nome utente e la password del server."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto nie je server own.audio. Prihlásenie cez Apple alebo Google funguje len tam; použite používateľské meno a heslo servera."
          }
        }
      }
    },
    "This own.audio server doesn't offer that sign-in. Use your email and password, or the other button." : {
      "localizations" : {
