            "value" : "Al momento non si può riprodurre."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To teraz nejde prehrať."
          }
        }
      }
    },
    "That code isn't right, or it has expired. Try the current one." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kód není správný, nebo už vypršel. Zadejte aktuální."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code stimmt nicht oder ist abgelaufen. Versuch es mit dem aktuellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código no es correcto o ha caducado. Prueba con el actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code est incorrect ou a expiré. Essayez le code actuel."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kód hibás, vagy lejárt. Próbálja meg az aktuálisat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il codice non è corretto o è scaduto. Prova quello attuale."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kód nie je správny alebo už vypršal. Zadajte aktuálny."
          }
        }
      }
    },
    "That doesn't look like an email address." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tohle nevypadá jako e-mailová adresa."
          }
        },
        "de" : {
          "stringUnit" : {
