    "Correct the words if the tags are wrong — a typo, “Track 02”, the artist in the title." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud jsou tagy špatně, opravte slova — překlep, „Track 02“, interpret v názvu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korrigiere die Wörter, wenn die Tags falsch sind – ein Tippfehler, „Track 02“, der Künstler im Titel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige las palabras si las etiquetas están mal: una errata, «Track 02», el artista en el título."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrigez les mots si les balises sont fausses — une faute de frappe, « Track 02 », l’artiste dans le titre."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Javítsa a szavakat, ha a címkék hibásak – elírás, „Track 02”, az előadó a címben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correggi le parole se i tag sono sbagliati: un refuso, “Track 02”, l’artista nel titolo."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak sú značky nesprávne, opravte slová — preklep, „Track 02“, interpret v názve."
          }
        }
      }
    },
