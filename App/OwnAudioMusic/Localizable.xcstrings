    "Add to Playlist…" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidat do playlistu…"
          }
        }
      }
    },
    "Added before this app spoke own.audio's own API, or from an older server. Sign in again to use it: the library on this iPhone then stays up to date within seconds." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidáno dřív, než aplikace uměla vlastní API own.audio, nebo ze staršího serveru. Přihlaste se znovu, aby ho používala: knihovna v tomto iPhonu pak bude aktuální během pár sekund."
          }
        }
      }
