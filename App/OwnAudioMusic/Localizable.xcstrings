            "value" : "Das sieht nicht wie eine E-Mail-Adresse aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso no parece una dirección de correo."
          }
        },
        "fr" : {
          "stringUnit" : {
