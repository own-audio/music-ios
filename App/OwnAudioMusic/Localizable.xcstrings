    "Chosen anew each time, from your own listening." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybírá se pokaždé znovu, podle toho, co posloucháte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird jedes Mal neu ausgewählt, nach dem, was du hörst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elige de nuevo cada vez, según lo que escuchas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle sélection à chaque fois, d’après ce que vous écoutez."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden alkalommal újra összeáll, aszerint, amit Ön hallgat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scelto ogni volta di nuovo, in base a ciò che ascolti."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberá sa zakaždým znova, podľa toho, čo počúvate."
          }
        }
      }
    },
    "Chosen anew each time, from your own listening. Shared with the family: everyone gets their own selection." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybírá se pokaždé znovu, podle toho, co posloucháte. Sdílený s rodinou: každý dostane vlastní výběr."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird jedes Mal neu ausgewählt, nach dem, was du hörst. Mit der Familie geteilt: Jede Person bekommt ihre eigene Auswahl."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elige de nuevo cada vez, según lo que escuchas. Compartida con la familia: cada uno recibe su propia selección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle sélection à chaque fois, d’après ce que vous écoutez. En partage familial : chacun reçoit sa propre sélection."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden alkalommal újra összeáll, aszerint, amit Ön hallgat. Megosztva a családdal: mindenki saját válogatást kap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scelto ogni volta di nuovo, in base a ciò che ascolti. Condiviso con la famiglia: ognuno riceve la propria selezione."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberá sa zakaždým znova, podľa toho, čo počúvate. Zdieľaný s rodinou: každý dostane vlastný výber."
          }
        }
      }
    },
