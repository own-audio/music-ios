          }
        }
      }
    },
    "Offline, and none of the songs left in the queue are downloaded." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jste offline a žádná ze zbývajících skladeb ve frontě není stažená."
