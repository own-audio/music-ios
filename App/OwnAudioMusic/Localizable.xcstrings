    "Quick Connect is turned off on this server. An administrator can turn it on in the dashboard, or sign in with your password." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect je na tomto serveru vypnutý. Správce ho může zapnout v ovládacím panelu, nebo se přihlaste heslem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect ist auf diesem Server ausgeschaltet. Ein Administrator kann es im Dashboard einschalten, oder melde dich mit deinem Passwort an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect está desactivado en este servidor. Un administrador puede activarlo en el panel, o inicia sesión con tu contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect est désactivé sur ce serveur. Un administrateur peut l’activer dans le tableau de bord ; sinon, connectez-vous avec votre mot de passe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Quick Connect ki van kapcsolva ezen a szerveren. Egy adminisztrátor bekapcsolhatja az irányítópulton, vagy jelentkezzen be jelszóval."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect è disattivato su questo server. Un amministratore può attivarlo nella dashboard, oppure accedi con la password."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect je na tomto serveri vypnutý. Správca ho môže zapnúť v ovládacom paneli, alebo sa prihláste heslom."
          }
        }
      }
    },
    "Quick Connect signs in to Jellyfin with a code you approve in a Jellyfin app where you're already signed in; no password typed here." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect přihlásí k Jellyfinu pomocí kódu, který schválíte v aplikaci Jellyfin, kde už jste přihlášeni; heslo se tu nezadává."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect meldet dich bei Jellyfin mit einem Code an, den du in einer Jellyfin-App bestätigst, in der du schon angemeldet bist; hier wird kein Passwort eingegeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect inicia sesión en Jellyfin con un código que apruebas en una app de Jellyfin en la que ya has iniciado sesión; aquí no se escribe ninguna contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect vous connecte à Jellyfin avec un code que vous approuvez dans une app Jellyfin où vous êtes déjà connecté ; aucun mot de passe à saisir ici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Quick Connect egy kóddal jelentkezteti be a Jellyfinbe: a kódot egy olyan Jellyfin-alkalmazásban hagyja jóvá, ahol már be van jelentkezve, így itt nem kell jelszót beírni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect accede a Jellyfin con un codice che approvi in un’app Jellyfin in cui hai già effettuato l’accesso; qui non si digita nessuna password."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Connect prihlási k Jellyfinu pomocou kódu, ktorý schválite v aplikácii Jellyfin, kde už ste prihlásení; heslo sa tu nezadáva."
          }
        }
      }
    },
    "Rated four stars or more, not heard for two months." : {
