    "Offline, and none of the songs left in the queue are downloaded." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jste offline a žádná ze zbývajících skladeb ve frontě není stažená."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline, und keiner der übrigen Titel in der Warteschlange ist geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás sin conexión y ninguna de las canciones que quedan en la cola está descargada."
          }
        },
        "fr" : {
