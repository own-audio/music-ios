    "With a code from that family's admin. You then leave this one." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S kódem od správce té rodiny. Z této pak odejdete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem Code vom Administrator dieser Familie. Diese hier verlässt du dann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un código del administrador de esa familia. Después sales de esta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec un code de l’administrateur de cette famille. Vous quittez alors celle-ci."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annak a családnak az adminisztrátorától kapott kóddal. Ebből a családból ezután kilép."
          }
        },
        "it" : {
          "stringUnit" : {
