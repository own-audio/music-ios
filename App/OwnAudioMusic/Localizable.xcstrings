    "It is shared with the family: it goes for everyone. Playlists made from it stay." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je sdílený s rodinou: zmizí všem. Playlisty z něj uložené zůstanou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ist mit der Familie geteilt: Sie verschwindet für alle. Daraus gespeicherte Playlists bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está compartida con la familia: desaparece para todos. Las playlists creadas a partir de ella se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est partagée avec la famille : elle disparaît pour tout le monde. Les playlists créées à partir d’elle restent."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meg van osztva a családdal: mindenkinél eltűnik. A belőle mentett listák megmaradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È condivisa con la famiglia: sparisce per tutti. Le playlist create da essa restano."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je zdieľaný s rodinou: zmizne všetkým. Playlisty z neho uložené zostanú."
          }
        }
      }
    },
    "It's among your playlists, as this rule chose it just now. It won't change from here on." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najdete ho mezi svými playlisty tak, jak ho pravidlo právě vybralo. Dál se už měnit nebude."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ist jetzt bei deinen Playlists, mit genau der Auswahl, die die Regel gerade getroffen hat. Ab jetzt ändert sie sich nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está entre tus playlists, tal como la regla la ha elegido ahora. Ya no cambiará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est parmi vos playlists, telle que la règle vient de la choisir. Elle ne changera plus."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A listái között találja, úgy, ahogy a szabály épp most összeállította. Ezentúl nem változik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È tra le tue playlist, così come la regola l’ha scelta ora. Da qui in poi non cambierà più."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nájdete ho medzi svojimi playlistami tak, ako ho pravidlo práve vybralo. Ďalej sa už meniť nebude."
          }
        }
      }
    },
    "Its downloads leave this device. Nothing changes on the server." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeho stažené položky z tohoto zařízení zmizí. Na serveru se nic nezmění."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Downloads werden von diesem Gerät entfernt. Auf dem Server ändert sich nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus descargas desaparecen de este dispositivo. En el servidor no cambia nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses téléchargements sont supprimés de cet appareil. Rien ne change sur le serveur."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A letöltései eltűnnek erről az eszközről. A szerveren semmi sem változik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
