    "Lets MusicBrainz name your songs and albums on the server. Nothing changes until you accept it, and the files stay as they are." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechá MusicBrainz pojmenovat vaše skladby a alba na serveru. Nic se nezmění, dokud to nepřijmete, a soubory zůstanou, jak jsou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt MusicBrainz deine Titel und Alben auf dem Server benennen. Nichts ändert sich, bis du es annimmst, und die Dateien bleiben, wie sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que MusicBrainz ponga nombre a tus canciones y álbumes en el servidor. Nada cambia hasta que lo aceptas, y los archivos se quedan como están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse MusicBrainz nommer vos morceaux et albums sur le serveur. Rien ne change tant que vous n’acceptez pas, et les fichiers restent tels quels."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MusicBrainz segítségével elnevezheti a számait és albumait a szerveren. Semmi sem változik, amíg el nem fogadja, és a fájlok változatlanok maradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia che MusicBrainz dia un nome ai tuoi brani e album sul server. Non cambia nulla finché non accetti, e i file restano come sono."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechá MusicBrainz pomenovať vaše skladby a albumy na serveri. Nič sa nezmení, kým to neprijmete, a súbory zostanú, ako sú."
          }
        }
      }
    },
