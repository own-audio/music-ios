    },
    "Tap the star on an artist." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na hvězdičku u interpreta."
          }
        }
      }
    },
    "That Didn't Work" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepovedlo se"
          }
        }
      }
    },
    "That doesn't look like a server address." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tohle nevypadá jako adresa serveru."
          }
        }
      }
    },
    "The library shows the selected server. Music from any server can stay in the queue." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knihovna ukazuje vybraný server. Hudba z kteréhokoli serveru může zůstat ve frontě."
          }
        }
      }
    },
    "The server didn't accept that username and password." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server toto uživatelské jméno a heslo nepřijal."
          }
        }
      }
    },
    "The server has no lyrics for this song. Navidrome reads them from the file's tags or an .lrc file next to it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server pro tuto skladbu nemá text. Navidrome ho čte ze značek souboru nebo ze souboru .lrc vedle něj."
          }
        }
      }
    },
    "The server no longer accepts this sign-in. Check it in Settings." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server už toto přihlášení nepřijímá. Zkontrolujte ho v Nastavení."
          }
        }
      }
    },
    "The server returned an error (%lld)." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server vrátil chybu (%lld)."
          }
        }
      }
    },
    "The server returned an error." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server vrátil chybu."
          }
        }
      }
    },
    "The server's answer couldn't be read. Is this a Subsonic server?" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpověď serveru se nepodařilo přečíst. Je to server Subsonic?"
          }
        }
      }
    },
    "They stay on the server and can be downloaded again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na serveru zůstanou a můžete je stáhnout znovu."
          }
        }
      }
    },
    "This deletes it on the server, for every app that uses it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smaže ho na serveru, pro všechny aplikace, které ho používají."
          }
        }
      }
    },
    "This server's library is empty." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knihovna tohoto serveru je prázdná."
          }
        }
      }
    },
    "Time remaining" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbývá"
          }
        }
      }
    },
    "Top Rated" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejlépe hodnocené"
          }
        }
      }
    },
    "Track %lld of %lld" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skladba %1$lld z %2$lld"
          }
        }
      }
    },
    "Tracks fade into each other near the end." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skladby se ke konci prolnou."
          }
        }
      }
    },
    "Tracks play back to back with no gap, so live and classical albums flow as recorded." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skladby hrají za sebou bez mezery, takže živá a klasická alba plynou tak, jak byla nahrána."
          }
        }
      }
    },
    "Treble Boost" : {
      "extractionState" : "stale",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zesílení výšek"
          }
        }
      }
    },
    "Try Again" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkusit znovu"
          }
        }
      }
    },
    "Turn Off Sleep Timer" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnout časovač usínání"
          }
        }
      }
    },
    "Unfavorite" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebrat z oblíbených"
          }
        }
      }
    },
    "Unfavorite Album" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebrat album z oblíbených"
          }
        }
      }
    },
    "Unfavorite Artist" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebrat interpreta z oblíbených"
          }
        }
      }
    },
    "Unreachable" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedostupný"
          }
        }
      }
    },
    "Up Next" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na řadě"
          }
        }
      }
    },
    "Username" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uživatelské jméno"
          }
        }
      }
    },
    "Uses the ReplayGain values in your files, so a quiet song and a loud one play at a similar volume. Per album keeps an album's own quiet and loud moments. Songs without the values play unchanged." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá hodnoty ReplayGain ve vašich souborech, takže tichá a hlasitá skladba hrají podobně nahlas. Volba pro album zachová tiché a hlasité chvíle uvnitř alba. Skladby bez těchto hodnot hrají beze změny."
          }
        }
      }
    },
    "Version" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verze"
          }
        }
      }
    },
    "Volume Leveling" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyrovnání hlasitosti"
          }
        }
      }
    },
    "Without http:// or https://, http is used, which suits a server at home." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez http:// nebo https:// se použije http, což se hodí pro server doma."
          }
        }
      }
    },
    "Your music, from your own server." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše hudba z vašeho vlastního serveru."
          }
        }
      }
    },
    "Your password stays in this iPhone's Keychain. Only a one-time token made from it is sent." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heslo zůstává v klíčence tohoto iPhonu. Odesílá se jen jednorázový token z něj vytvořený."
          }
        }
      }
    },
    "Saver" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsporný"
          }
        }
      }
    },
    "Downloaded Only" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jen stažené"
          }
        }
      }
    },
    "Saver Quality" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvalita při úspoře"
          }
        }
      }
    },
    "Stream" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streamovat"
          }
        }
      }
    },
    "Mobile data · downloaded music only" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilní data · jen stažená hudba"
          }
        }
      }
    },
    "Saver asks the server for a smaller MP3 of each song as it plays; servers that can't make one send the original. Downloaded Only plays just what's on this iPhone while on mobile data. With iOS Low Data Mode on, streams are kept at 128 kbps. Wi-Fi and downloads always get the original file." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úsporně: server pošle každou skladbu jako menší MP3; server, který to neumí, pošle originál. Jen stažené: na mobilních datech hraje jen to, co je v tomto iPhonu. Se zapnutým režimem nízkých dat v iOS se streamuje nejvýš 128 kb/s. Na Wi-Fi a při stahování jde vždy originální soubor."
          }
        }
      }
    },
    "No server yet?" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ještě nemáte server?"
          }
        }
      }
    },
    "Try the Demo Library" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyzkoušet ukázkovou knihovnu"
          }
        }
      }
    },
    "A shared own.audio server with sample music. Remove it in Settings when you add your own." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílený server own.audio s ukázkovou hudbou. Až přidáte vlastní, odeberete ho v Nastavení."
          }
        }
      }
    },
    "own.audio: sign in with your account's email and password." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio: přihlaste se e-mailem a heslem ke svému účtu."
          }
        }
      }
    },
    "Works with own.audio, Navidrome and other Subsonic servers, and Jellyfin; the app finds out which. Without http:// or https://, it tries https and then http. Your sign-in stays in this phone's Keychain.\n\nown.audio: sign in with your account's email and password." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funguje s own.audio, Navidrome a dalšími servery Subsonic i s Jellyfinem; aplikace sama pozná, o který jde. Bez http:// nebo https:// zkusí nejdřív https a pak http. Přihlašovací údaje zůstávají v klíčence tohoto telefonu.\n\nown.audio: přihlaste se e-mailem a heslem ke svému účtu."
          }
        }
      }
    },
    "Whole Library When Offline" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celá knihovna offline"
          }
        }
      }
    },
    "Offline Mode shows and plays only what is on this iPhone, as it does on its own with no network. Saves mobile data.\n\nWith Whole Library, the offline screens list everything on the server, from a copy of its catalogue kept on this iPhone; what isn't downloaded is greyed out. Albums open offline either way.\n\nOver the limit, the songs not played for longest go first; never the one playing." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Režim offline zobrazuje a přehrává jen to, co je v tomto iPhonu, stejně jako bez sítě. Šetří mobilní data.\n\nS celou knihovnou ukazují offline obrazovky vše, co je na serveru, z kopie jeho katalogu uložené v tomto iPhonu; co není stažené, je zašedlé. Alba se offline otevřou v obou případech.\n\nNad limitem jdou první skladby, které nehrály nejdéle; nikdy ne ta, která hraje."
          }
        }
      }
    },
    "Library on This iPhone" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knihovna v tomto iPhonu"
          }
        }
      }
    },
    "Update Now" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizovat"
          }
        }
      }
    },
    "Updating…" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizuje se…"
          }
        }
      }
    },
    "Songs: %lld · Albums: %lld" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skladby: %lld · Alba: %lld"
          }
        }
      }
    },
    "Updated %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizováno %@"
          }
        }
      }
    },
    "Not yet updated" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím neaktualizováno"
          }
        }
      }
    },
    "A list of everything on the server, without the music itself, so albums open and the library can be browsed offline. Updated in the background, on Wi-Fi." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seznam všeho na serveru, bez samotné hudby, aby se alba otevřela a knihovnu šlo procházet i offline. Aktualizuje se na pozadí, na Wi-Fi."
          }
        }
      }
    },
    "Apple didn't return a sign-in. Try again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple nevrátil přihlášení. Zkuste to znovu."
          }
        }
      }
    },
    "own.audio canary (testing)" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio canary (testovací)"
          }
        }
      }
    },
    "Continue with Google" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokračovat pomocí Googlu"
          }
        }
      }
    },
    "Google didn't return a sign-in. Try again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google nevrátil přihlášení. Zkuste to znovu."
          }
        }
      }
    },
    "This isn't an own.audio server. Sign in with Apple or Google works only there; use the server's username and password." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tohle není server own.audio. Přihlášení přes Apple nebo Google funguje jen tam; použijte uživatelské jméno a heslo serveru."
          }
        }
      }
    },
    "This own.audio server doesn't offer that sign-in. Use your email and password, or the other button." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento server own.audio takové přihlášení nenabízí. Použijte e-mail a heslo, nebo druhé tlačítko."
          }
        }
      }
    },
    "Identify Whole Library" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifikovat celou knihovnu"
          }
        }
      }
    },
    "Compares your songs with MusicBrainz in the background, then shows what it found: accept the sure matches at once, look at the rest one by one. Your files never change, and a run can be undone. MusicBrainz answers about one album a second, so a large library takes a while." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porovná vaše skladby s MusicBrainz na pozadí a pak ukáže, co našel: jisté shody přijmete najednou, ostatní projdete jednu po druhé. Vaše soubory se nikdy nemění a běh jde vrátit. MusicBrainz odpovídá zhruba na jedno album za sekundu, takže velká knihovna chvíli trvá."
          }
        }
      }
    },
