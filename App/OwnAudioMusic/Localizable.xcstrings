            "value" : "Tempo a energia"
          }
        }
      }
    },
    "That address now answers as a different server. Add it as a new server instead." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na této adrese teď odpovídá jiný server. Přidejte ho jako nový server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dieser Adresse antwortet jetzt ein anderer Server. Füge ihn stattdessen als neuen Server hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa dirección responde ahora como otro servidor. Añádela como servidor nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette adresse répond désormais comme un autre serveur. Ajoutez-la plutôt comme nouveau serveur."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezen a címen most egy másik szerver válaszol. Adja hozzá új szerverként."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quell’indirizzo ora risponde come un altro server. Aggiungilo come nuovo server."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tejto adrese teraz odpovedá iný server. Pridajte ho ako nový server."
          }
        }
      }
    },
    "That can't play right now." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To teď nejde přehrát."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
