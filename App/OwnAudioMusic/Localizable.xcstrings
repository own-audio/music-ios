        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozbeh, ustálenie, upokojenie"
          }
        }
      }
    },
    "Week" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týden"
          }
        },
        "de" : {
