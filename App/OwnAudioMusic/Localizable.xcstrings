        }
      }
    },
    "On Mobile Data" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na mobilních datech"
          }
        }
      }
    },
    "On mobile data, a server that can (Jellyfin today) makes a smaller MP3 of each song as it plays. On Wi-Fi, and for downloads, it's always the original file." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na mobilních datech může server, který to umí (dnes Jellyfin), při přehrávání vytvářet z každé skladby menší MP3. Na Wi-Fi a při stahování je to vždy původní soubor."
          }
        }
      }
    },
    "Original" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Původní"
          }
        }
      }
    },
    "own.audio · own API" : {
      "localizations" : {
