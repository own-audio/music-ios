    "%lld tracks, %lld matched" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld skladeb, %2$lld spárováno"
          }
        }
      }
    },
    "Lets MusicBrainz name your songs and albums on the server. Nothing changes until you accept it, and the files stay as they are." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechá MusicBrainz pojmenovat vaše skladby a alba na serveru. Nic se nezmění, dokud to nepřijmete, a soubory zůstanou, jak jsou."
          }
        }
      }
    },
