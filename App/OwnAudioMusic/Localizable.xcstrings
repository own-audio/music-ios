    "own.audio didn't create the account." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio účet nevytvořil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio hat das Konto nicht erstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio no ha creado la cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio n’a pas créé le compte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az own.audio nem hozta létre a fiókot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio non ha creato l’account."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio účet nevytvoril."
          }
        }
      }
    },
    "own.audio emails you a link to confirm the address. By creating an account you agree to the [Terms](https://www.own.audio/terms/) and the [Privacy Policy](https://www.own.audio/privacy/)." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio vám e-mailem pošle odkaz k potvrzení adresy. Vytvořením účtu souhlasíte s [podmínkami](https://www.own.audio/terms/) a [zásadami ochrany osobních údajů](https://www.own.audio/privacy/)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio schickt dir per E-Mail einen Link, um die Adresse zu bestätigen. Mit dem Erstellen eines Kontos stimmst du den [Nutzungsbedingungen](https://www.own.audio/terms/) und der [Datenschutzerklärung](https://www.own.audio/privacy/) zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio te envía un enlace por correo para confirmar la dirección. Al crear una cuenta aceptas los [Términos](https://www.own.audio/terms/) y la [Política de privacidad](https://www.own.audio/privacy/)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio vous envoie par e-mail un lien pour confirmer l’adresse. En créant un compte, vous acceptez les [Conditions d’utilisation](https://www.own.audio/terms/) et la [Politique de confidentialité](https://www.own.audio/privacy/)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az own.audio e-mailben küld egy hivatkozást a cím megerősítéséhez. A fiók létrehozásával elfogadja a [feltételeket](https://www.own.audio/terms/) és az [adatvédelmi irányelveket](https://www.own.audio/privacy/)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio ti invia per e-mail un link per confermare l’indirizzo. Creando un account accetti i [Termini](https://www.own.audio/terms/) e l’[Informativa sulla privacy](https://www.own.audio/privacy/)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio vám e-mailom pošle odkaz na potvrdenie adresy. Vytvorením účtu súhlasíte s [podmienkami](https://www.own.audio/terms/) a [zásadami ochrany osobných údajov](https://www.own.audio/privacy/)."
          }
        }
      }
    },
    "own.audio isn't taking new accounts right now." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio teď nové účty nepřijímá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio nimmt gerade keine neuen Konten an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio no admite cuentas nuevas en este momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio n’accepte pas de nouveaux comptes pour l’instant."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az own.audio jelenleg nem fogad új fiókokat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio al momento non accetta nuovi account."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio teraz nové účty neprijíma."
          }
        }
      }
    },
    "own.audio keeps your music for you. Upload it once and play it here." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio vaši hudbu uchová za vás. Jednou ji nahrajte a přehrávejte ji tady."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio bewahrt deine Musik für dich auf. Lade sie einmal hoch und spiele sie hier ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio guarda tu música por ti. Súbela una vez y escúchala aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio garde votre musique pour vous. Importez-la une fois et écoutez-la ici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az own.audio megőrzi a zenéjét. Töltse fel egyszer, és játssza le itt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio conserva la tua musica per te. Caricala una volta e ascoltala qui."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio vašu hudbu uchová za vás. Raz ju nahrajte a prehrávajte ju tu."
          }
        }
      }
    },
    "own.audio Music is free and open source (MPL-2.0). It talks only to the servers you add." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio Music je zdarma a open source (MPL-2.0). Mluví jen se servery, které přidáte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio Music ist kostenlos und Open Source (MPL-2.0). Die App spricht nur mit den Servern, die du hinzufügst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio Music es gratis y de código abierto (MPL-2.0). Solo se comunica con los servidores que añades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio Music est gratuit et open source (MPL-2.0). L’app ne communique qu’avec les serveurs que vous ajoutez."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az own.audio Music ingyenes és nyílt forráskódú (MPL-2.0). Csak az Ön által hozzáadott szerverekkel kommunikál."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio Music è gratuita e open source (MPL-2.0). Comunica solo con i server che aggiungi."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "own.audio Music je zadarmo a open source (MPL-2.0). Komunikuje len so servermi, ktoré pridáte."
          }
        }
      }
    },
