    "A whole concert in one file, with a chapter where each song starts, shows up here." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tady se objeví celý koncert v jednom souboru, s kapitolou na začátku každé skladby."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ganzes Konzert in einer Datei, mit einem Kapitel an jedem Titelanfang, erscheint hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparece un concierto entero en un solo archivo, con un capítulo donde empieza cada canción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un concert entier dans un seul fichier, avec un chapitre au début de chaque morceau, apparaît ici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itt jelenik meg minden egy fájlban rögzített teljes koncert, amelyben fejezet jelöli az egyes számok kezdetét."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compare un concerto intero in un unico file, con un capitolo all’inizio di ogni brano."
