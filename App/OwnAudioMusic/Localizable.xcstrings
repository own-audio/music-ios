    "No one release fits all these songs, so each was matched on its own. Pick a release to match the whole album to it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádné jedno vydání nesedí na všechny tyto skladby, proto se každá párovala zvlášť. Vyberte vydání, ke kterému se má spárovat celé album."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine einzelne Veröffentlichung passt zu all diesen Titeln, daher wurde jeder für sich zugeordnet. Wähle eine Veröffentlichung, um ihr das ganze Album zuzuordnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna publicación encaja con todas estas canciones, así que cada una se ha identificado por separado. Elige una publicación para identificar todo el álbum con ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune parution ne correspond à tous ces morceaux ; chacun a donc été associé séparément. Choisissez une parution pour y associer tout l’album."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs olyan kiadás, amelyre az összes szám illik, ezért mindegyik szám külön lett egyeztetve. Válasszon egy kiadást, és az egész album ahhoz lesz egyeztetve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna pubblicazione corrisponde a tutti questi brani, quindi ognuno è stato abbinato da solo. Scegli una pubblicazione per abbinarle l’intero album."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žiadne jedno vydanie nesedí na všetky tieto skladby, preto sa každá párovala zvlášť. Vyberte vydanie, ku ktorému sa má spárovať celý album."
          }
        }
      }
    },
    "No other editions were found." : {
